{
  "manifest_version": 3,
  "name": "ThreatScanner Shield",
  "version": "1.6",
  "description": "Real-time ML-powered malicious link detector.",
  "permissions": ["storage", "alarms", "webNavigation", "downloads", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ThreatScanner Shield",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["cache.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
