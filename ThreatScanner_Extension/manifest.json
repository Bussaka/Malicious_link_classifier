
{
  "manifest_version": 3,
  "name": "ThreatScanner Shield",
  "version": "1.1",
  "description": "Real-time ML-powered malicious link detector.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8000/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}